PORT=4001

# Local dev (default) — docker-compose's postgres service, or the standalone container
DATABASE_URL=postgres://postgres:postgres@localhost:5432/miniledger
# AWS RDS (staging/production) — format once provisioned:
# DATABASE_URL=postgres://<username>:<password>@<db-instance-id>.<random-id>.<region>.rds.amazonaws.com:5432/miniledger

DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/miniledger_test
JWT_SECRET=changeme
